#!/usr/bin/env bash
# netbae - manage the netBae service. Installed to /usr/local/bin/netbae.
set -euo pipefail

REPO="__NETBAE_REPO__"   # filled in by install.sh
if [[ $(uname -s) == Darwin ]]; then
  APP=/usr/local/lib/netbae
  CONF=/usr/local/etc/netbae/config.toml
  LABEL=com.github.netbae
  PLIST=/Library/LaunchDaemons/$LABEL.plist
  LOG=/usr/local/var/log/netbae.log
  # the Python 3.11+ chosen by the installer (the system python3 may be older)
  PY=$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$PLIST" 2>/dev/null || echo python3)
else
  APP=/opt/netbae
  CONF=/etc/netbae/config.toml
  PY=python3
fi

as_root() { if [[ $EUID -eq 0 ]]; then "$@"; else sudo "$@"; fi; }
as_svc() {
  if [[ $(uname -s) == Darwin ]]; then as_root sudo -u _netbae "$@"; elif command -v runuser >/dev/null; then as_root runuser -u netbae -- "$@"; else as_root sudo -u netbae "$@"; fi
}
version() { "$PY" -c "import sys; sys.path.insert(0, '$APP'); import netbae; print(netbae.VERSION)" 2>/dev/null || echo unknown; }

# service control: systemd on Linux, launchd on macOS
svc() {
  if [[ $(uname -s) != Darwin ]]; then
    case $1 in
      status) systemctl status netbae --no-pager ;;
      logs) journalctl -u netbae -f ;;
      *) as_root systemctl "$1" netbae ;;
    esac
    return
  fi
  case $1 in
    status)
      launchctl print "system/$LABEL" 2>/dev/null \
        | grep -E $'^\t(state|pid|last exit code|runs) =' | sed $'s/^\t/  /' \
        || { echo "netBae is not running (not loaded in launchd)"; return 3; }
      ;;
    logs) as_root tail -n 50 -f "$LOG" ;;  # the log is only readable by the service user and root
    start) as_root launchctl bootstrap system "$PLIST" 2>/dev/null || as_root launchctl kickstart "system/$LABEL" ;;
    stop) as_root launchctl bootout "system/$LABEL" ;;
    restart)
      if launchctl print "system/$LABEL" >/dev/null 2>&1; then
        as_root launchctl kickstart -k "system/$LABEL"
      else
        as_root launchctl bootstrap system "$PLIST"
      fi
      ;;
  esac
}

case "${1:-help}" in
  update|upgrade)
    echo "Installed: netBae $(version). Fetching the latest from github.com/$REPO …"
    curl -fsSL "https://raw.githubusercontent.com/$REPO/main/install.sh" | as_root env NETBAE_REPO="$REPO" bash
    ;;
  status)  svc status ;;
  logs)    svc logs ;;
  restart) svc restart && echo "restarted" ;;
  stop)    svc stop ;;
  start)   svc start ;;
  config)
    as_root "${EDITOR:-nano}" "$CONF"
    if as_svc "$PY" "$APP/netbae.py" -c "$CONF" --check-config >/dev/null; then
      svc restart && echo "config OK - netBae restarted"
    else
      echo "config has errors - not restarted" >&2; exit 1
    fi
    ;;
  check)   as_svc "$PY" "$APP/netbae.py" -c "$CONF" --check-config ;;
  version) echo "netBae $(version)" ;;
  uninstall) as_root bash "$APP/uninstall.sh" "${@:2}" ;;
  *)
    cat <<HELP
netbae - manage the netBae internet monitor

  netbae update       update to the latest version (keeps config + data)
  netbae status       service status
  netbae logs         follow the log
  netbae config       edit the config, validate it and restart
  netbae check        validate the config and show the next speedtest times
  netbae restart | start | stop
  netbae version
  netbae uninstall [--purge]
HELP
    ;;
esac
